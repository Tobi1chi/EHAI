{
  "name": "rail.trip",
  "description": "只读查询 12306，整理出行方案供确认；不购票、不创建日程或待办。",
  "expected_revision": null,
  "inputs_schema": {
    "type": "object",
    "properties": {
      "from": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "to": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "earliest": {
        "type": "string",
        "pattern": "^$|^\\d{2}:\\d{2}$"
      },
      "latest": {
        "type": "string",
        "pattern": "^$|^\\d{2}:\\d{2}$"
      },
      "preferences": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [
      "from",
      "to",
      "date",
      "earliest",
      "latest",
      "preferences"
    ],
    "additionalProperties": false
  },
  "start": "plan",
  "steps": [
    {
      "id": "plan",
      "type": "agent",
      "instruction": {
        "template": "请为 {input.date} 从 {input.from} 到 {input.to} 整理 2–3 个可核查的出行方案。出发时间窗口：{input.earliest} 至 {input.latest}（空白表示不限）；偏好：{input.preferences}。优先直达，合适时查询中转。用提供的工具核查车站、车次、余票、票价与经停；票价查询所需的车次内部编号、站序和席别参数须取自工具结果，不要猜测。车站参数请传车站名称，不传电报码。说明各方案的取舍、总价、总时长和换乘次数，保留查询链接。无法核实的价格用 null，余票和 notes 明确写出不确定性，不虚构方案；确实不足时可只给 1 个方案并解释。不得登录、订票、付款、创建日程或待办。最后单独调用 submit_result。所有面向旅客的文字（尤其 notes、remaining）都用通俗中文，不出现工具字段名、内部编号或电报码；例如余票写“至少 21 张”，不要写 remaining_at_least=true、bookable=true、seat_types=9MOO 或 VNP/AOH。"
      },
      "tools": [
        {
          "connector_id": "REPLACE_WITH_REGISTERED_RAIL_CONNECTOR_ID",
          "action": "rail.stations.search",
          "action_version": "1"
        },
        {
          "connector_id": "REPLACE_WITH_REGISTERED_RAIL_CONNECTOR_ID",
          "action": "rail.tickets.search",
          "action_version": "1"
        },
        {
          "connector_id": "REPLACE_WITH_REGISTERED_RAIL_CONNECTOR_ID",
          "action": "rail.tickets.price",
          "action_version": "1"
        },
        {
          "connector_id": "REPLACE_WITH_REGISTERED_RAIL_CONNECTOR_ID",
          "action": "rail.transfers.search",
          "action_version": "1"
        },
        {
          "connector_id": "REPLACE_WITH_REGISTERED_RAIL_CONNECTOR_ID",
          "action": "rail.route.get",
          "action_version": "1"
        }
      ],
      "output_schema": {
        "type": "object",
        "properties": {
          "plans": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "legs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "properties": {
                      "train": {
                        "type": "string"
                      },
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string"
                      },
                      "depart": {
                        "type": "string"
                      },
                      "arrive": {
                        "type": "string"
                      },
                      "seat_class": {
                        "type": "string"
                      },
                      "price_cny": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "remaining": {
                        "type": "string"
                      },
                      "url": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "train",
                      "from",
                      "to",
                      "date",
                      "depart",
                      "arrive",
                      "seat_class",
                      "price_cny",
                      "remaining",
                      "url"
                    ],
                    "additionalProperties": false
                  }
                },
                "total_price_cny": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "total_duration": {
                  "type": "string"
                },
                "transfers": {
                  "type": "integer"
                },
                "why": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "summary",
                "legs",
                "total_price_cny",
                "total_duration",
                "transfers",
                "why"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "plans",
          "notes"
        ],
        "additionalProperties": false
      },
      "max_tool_calls": 30,
      "timeout_seconds": 900,
      "next": "review"
    },
    {
      "id": "review",
      "type": "human",
      "question": "这几个出行方案可以吗？",
      "subject": {
        "request": {
          "ref": "input"
        },
        "plans": {
          "ref": "steps.plan.plans"
        },
        "notes": {
          "ref": "steps.plan.notes"
        }
      },
      "on_approve": "reviewed",
      "on_reject": "dismissed"
    },
    {
      "id": "reviewed",
      "type": "end",
      "outcome": "reviewed",
      "result": {
        "review": {
          "ref": "steps.review"
        }
      }
    },
    {
      "id": "dismissed",
      "type": "end",
      "outcome": "dismissed",
      "result": {
        "review": {
          "ref": "steps.review"
        }
      }
    }
  ]
}
