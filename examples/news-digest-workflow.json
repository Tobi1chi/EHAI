{
  "name": "news.digest",
  "description": "多源订阅读取、逐条筛选后交给用户过目；保存前替换两个 connector_id。",
  "expected_revision": null,
  "inputs_schema": {
    "type": "object",
    "properties": {
      "urls": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "pattern": "^https?://"}},
      "max_items_per_feed": {"type": "integer", "minimum": 1, "maximum": 100},
      "question": {"type": "string", "minLength": 1, "maxLength": 1000},
      "choices": {
        "type": "array", "minItems": 2, "maxItems": 10,
        "items": {
          "type": "object",
          "properties": {
            "value": {"type": "string", "pattern": "^[a-z0-9_]{1,40}$"},
            "description": {"type": "string", "minLength": 1, "maxLength": 300}
          },
          "required": ["value", "description"], "additionalProperties": false
        }
      },
      "keep": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "pattern": "^[a-z0-9_]{1,40}$"}}
    },
    "required": ["urls", "max_items_per_feed", "question", "choices", "keep"],
    "additionalProperties": false
  },
  "start": "fetch",
  "steps": [
    {
      "id": "fetch", "type": "action",
      "connector_id": "REPLACE_WITH_REGISTERED_RSS_CONNECTOR_ID",
      "action": "feed.fetch_many", "action_version": "1",
      "inputs": {"urls": {"ref": "input.urls"}, "max_items_per_feed": {"ref": "input.max_items_per_feed"}},
      "next": "classify"
    },
    {
      "id": "classify", "type": "action",
      "connector_id": "REPLACE_WITH_REGISTERED_DECISIONS_CONNECTOR_ID",
      "action": "decisions.classify", "action_version": "1",
      "inputs": {
        "items": {"ref": "steps.fetch.items"},
        "id_field": {"value": "link"},
        "text_fields": {"value": ["title", "summary", "feed_title"]},
        "question": {"ref": "input.question"},
        "choices": {"ref": "input.choices"},
        "keep": {"ref": "input.keep"}
      },
      "next": "has_kept"
    },
    {
      "id": "has_kept", "type": "condition",
      "cases": [{"when": {"op": "gt", "left": {"ref": "steps.classify.counts.kept"}, "right": {"value": 0}}, "next": "review"}],
      "default": "nothing_kept"
    },
    {
      "id": "review", "type": "human", "question": "今天筛出的这些值得看吗？",
      "subject": {"kept": {"ref": "steps.classify.kept"}, "counts": {"ref": "steps.classify.counts"}},
      "on_approve": "reviewed", "on_reject": "dismissed"
    },
    {"id": "reviewed", "type": "end", "outcome": "reviewed", "result": {"review": {"ref": "steps.review"}}},
    {"id": "dismissed", "type": "end", "outcome": "dismissed", "result": {"review": {"ref": "steps.review"}}},
    {"id": "nothing_kept", "type": "end", "outcome": "nothing_kept", "result": {"counts": {"ref": "steps.classify.counts"}}}
  ]
}
