{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "daemon",
  "description": "The workbench served by the local EHAI daemon may pick a project folder and post system notifications.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*/*", "http://localhost:*/*"]
  },
  "permissions": [
    "dialog:allow-open",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify"
  ]
}
