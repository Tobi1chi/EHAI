{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ehai.local/v1/queries.schema.json",
  "title": "EHAI P1 query contracts",
  "$defs": {
    "RunStatus": {
      "type": "string",
      "enum": ["pending", "running", "paused", "completed", "failed", "cancelled"]
    },
    "AttemptStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "interrupted"
      ]
    },
    "PlanRevisionStatus": {
      "type": "string",
      "enum": ["draft", "approved"]
    },
    "PlanNodeKind": {
      "type": "string",
      "enum": ["work", "fork", "evaluator", "merge", "reviewer"]
    },
    "PlanNodeStatus": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "running",
        "candidate",
        "verifying",
        "blocked",
        "completed",
        "failed",
        "pruned"
      ]
    },
    "EdgeType": {
      "type": "string",
      "enum": ["dependency", "exploration", "conditional", "merge"]
    },
    "BranchStatus": {
      "type": "string",
      "enum": ["active", "selected", "pruned"]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": ["candidate", "evidence", "log", "patch", "worker_output", "check_output"]
    },
    "CheckKind": {
      "type": "string",
      "enum": ["command", "artifact", "semantic", "human"]
    },
    "CheckRunStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "timed_out",
        "cancelled",
        "interrupted"
      ]
    },
    "NullableId": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/Id"},
        {"type": "null"}
      ]
    },
    "NullableUtcDateTime": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        {"type": "null"}
      ]
    },
    "NullableString": {
      "type": ["string", "null"]
    },
    "IdList": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/Id"}
    },
    "GoalWorkerBudgetView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_worker_attempts", "used", "remaining"],
      "properties": {
        "max_worker_attempts": {"type": "integer", "minimum": 1},
        "used": {"type": "integer", "minimum": 0},
        "remaining": {"type": "integer", "minimum": 0}
      }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "goal_id",
        "plan_revision_id",
        "status",
        "created_at",
        "started_at",
        "ended_at",
        "status_reason"
      ],
      "properties": {
        "run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "goal_id": {"$ref": "common.schema.json#/$defs/Id"},
        "plan_revision_id": {"$ref": "common.schema.json#/$defs/Id"},
        "status": {"$ref": "#/$defs/RunStatus"},
        "predecessor_run_id": {"$ref": "#/$defs/NullableId"},
        "goal_worker_budget": {
          "oneOf": [{"$ref": "#/$defs/GoalWorkerBudgetView"}, {"type": "null"}]
        },
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "started_at": {"$ref": "#/$defs/NullableUtcDateTime"},
        "ended_at": {"$ref": "#/$defs/NullableUtcDateTime"},
        "status_reason": {"$ref": "#/$defs/NullableString"}
      }
    },
    "PlanNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_node_id",
        "title",
        "instruction",
        "kind",
        "required_dependency_ids",
        "required_check_ids",
        "status",
        "required_capabilities",
        "session_policy"
      ],
      "properties": {
        "plan_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "title": {"type": "string"},
        "instruction": {"type": "string"},
        "kind": {"$ref": "#/$defs/PlanNodeKind"},
        "required_dependency_ids": {"$ref": "#/$defs/IdList"},
        "required_check_ids": {"$ref": "#/$defs/IdList"},
        "status": {"$ref": "#/$defs/PlanNodeStatus"},
        "required_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "session_policy": {"type": "string", "enum": ["new", "reuse", "fork"]}
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_node_id",
        "target_node_id",
        "edge_type",
        "branch_id",
        "condition"
      ],
      "properties": {
        "edge_id": {"$ref": "common.schema.json#/$defs/Id"},
        "source_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "target_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "edge_type": {"$ref": "#/$defs/EdgeType"},
        "branch_id": {"$ref": "#/$defs/NullableId"},
        "condition": {"$ref": "#/$defs/NullableString"}
      }
    },
    "Branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_id",
        "label",
        "fork_node_id",
        "node_ids",
        "merge_node_id",
        "status"
      ],
      "properties": {
        "branch_id": {"$ref": "common.schema.json#/$defs/Id"},
        "label": {"type": "string"},
        "fork_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "node_ids": {"$ref": "#/$defs/IdList"},
        "merge_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "status": {"$ref": "#/$defs/BranchStatus"}
      }
    },
    "PlanPhase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "title",
        "node_ids",
        "reviewer_node_id",
        "gate_node_id",
        "rework_node_ids"
      ],
      "properties": {
        "phase_id": {"$ref": "common.schema.json#/$defs/Id"},
        "title": {"type": "string", "minLength": 1},
        "node_ids": {"$ref": "#/$defs/IdList"},
        "reviewer_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "gate_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "rework_node_ids": {"$ref": "#/$defs/IdList"}
      }
    },
    "PlanGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_revision_id",
        "process_revision_id",
        "goal_id",
        "version",
        "completion_contract_id",
        "completion_contract_version",
        "created_at",
        "status",
        "approved_at",
        "supersedes_plan_revision_id",
        "nodes",
        "edges",
        "branches",
        "phases"
      ],
      "properties": {
        "plan_revision_id": {"$ref": "common.schema.json#/$defs/Id"},
        "process_revision_id": {"$ref": "#/$defs/NullableId"},
        "goal_id": {"$ref": "common.schema.json#/$defs/Id"},
        "version": {"type": "integer", "minimum": 1},
        "completion_contract_id": {"$ref": "common.schema.json#/$defs/Id"},
        "completion_contract_version": {"type": "integer", "minimum": 1},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "status": {"$ref": "#/$defs/PlanRevisionStatus"},
        "approved_at": {"$ref": "#/$defs/NullableUtcDateTime"},
        "supersedes_plan_revision_id": {"$ref": "#/$defs/NullableId"},
        "design_document": {"type": ["string", "null"], "maxLength": 64000},
        "nodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/PlanNode"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/Edge"}
        },
        "branches": {
          "type": "array",
          "items": {"$ref": "#/$defs/Branch"}
        },
        "phases": {
          "type": "array",
          "items": {"$ref": "#/$defs/PlanPhase"}
        }
      }
    },
    "ProcessRevisionSource": {
      "type": "string",
      "enum": ["run_started", "legacy_snapshot", "planner_adjustment"]
    },
    "ProcessRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_revision_id",
        "run_id",
        "version",
        "parent_process_revision_id",
        "gate_owners",
        "source",
        "reason",
        "created_at",
        "graph"
      ],
      "properties": {
        "process_revision_id": {"$ref": "common.schema.json#/$defs/Id"},
        "run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "version": {"type": "integer", "minimum": 1},
        "parent_process_revision_id": {"$ref": "#/$defs/NullableId"},
        "gate_owners": {
          "type": "object",
          "propertyNames": {"$ref": "common.schema.json#/$defs/Id"},
          "additionalProperties": {"$ref": "common.schema.json#/$defs/Id"}
        },
        "source": {"$ref": "#/$defs/ProcessRevisionSource"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 16000},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "graph": {"$ref": "#/$defs/PlanGraph"}
      }
    },
    "ProcessDraftStatus": {
      "type": "string",
      "enum": ["planning", "ready", "failed"]
    },
    "ProcessDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_id",
        "run_id",
        "parent_process_revision_id",
        "planner_session_ref_id",
        "status",
        "reason",
        "created_at",
        "completed_at",
        "error",
        "base_is_current",
        "base_execution_plan",
        "candidate"
      ],
      "properties": {
        "draft_id": {"$ref": "common.schema.json#/$defs/Id"},
        "run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "parent_process_revision_id": {"$ref": "common.schema.json#/$defs/Id"},
        "planner_session_ref_id": {"$ref": "common.schema.json#/$defs/Id"},
        "status": {"$ref": "#/$defs/ProcessDraftStatus"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 16000},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "completed_at": {"$ref": "#/$defs/NullableUtcDateTime"},
        "error": {"$ref": "#/$defs/NullableString"},
        "base_is_current": {"type": "boolean"},
        "base_execution_plan": {"$ref": "#/$defs/PlanGraph"},
        "candidate": {
          "oneOf": [
            {"$ref": "#/$defs/ProcessRevision"},
            {"type": "null"}
          ]
        }
      }
    },
    "RunProcessDrafts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "drafts"],
      "properties": {
        "run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "drafts": {
          "type": "array",
          "items": {"$ref": "#/$defs/ProcessDraft"}
        }
      }
    },
    "ProcessBoundarySourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "quote"],
      "properties": {
        "source_key": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 16000}
      }
    },
    "ProcessBoundaryAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect",
        "judgment",
        "explanation",
        "source_refs",
        "candidate_node_ids"
      ],
      "properties": {
        "aspect": {
          "type": "string",
          "enum": ["requirements", "interfaces", "permissions", "gate_scope", "result_reuse"]
        },
        "judgment": {
          "type": "string",
          "enum": ["preserved", "not_preserved", "uncertain"]
        },
        "explanation": {"type": "string", "minLength": 1, "maxLength": 16000},
        "source_refs": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/ProcessBoundarySourceRef"}
        },
        "candidate_node_ids": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "common.schema.json#/$defs/Id"}
        }
      }
    },
    "ProcessBoundaryObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "description", "source_refs"],
      "properties": {
        "key": {"type": "string", "minLength": 1, "maxLength": 16000},
        "description": {"type": "string", "minLength": 1, "maxLength": 16000},
        "source_refs": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/ProcessBoundarySourceRef"}
        }
      }
    },
    "ProcessBoundaryImplementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_key", "alternatives"],
      "properties": {
        "obligation_key": {"type": "string", "minLength": 1, "maxLength": 16000},
        "alternatives": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "array",
            "maxItems": 256,
            "items": {"$ref": "common.schema.json#/$defs/Id"}
          }
        }
      }
    },
    "ProcessBoundaryGateScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_gate_id", "obligation_keys"],
      "properties": {
        "original_gate_id": {"$ref": "common.schema.json#/$defs/Id"},
        "obligation_keys": {
          "type": "array",
          "maxItems": 256,
          "items": {"type": "string", "minLength": 1, "maxLength": 16000}
        }
      }
    },
    "ProcessBoundaryObligationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligations", "implementations", "gate_scopes"],
      "properties": {
        "obligations": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/ProcessBoundaryObligation"}
        },
        "implementations": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/ProcessBoundaryImplementation"}
        },
        "gate_scopes": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/ProcessBoundaryGateScope"}
        }
      }
    },
    "ProcessBoundaryReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "assessments", "obligation_mapping", "evidence_artifact_ids"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 16000},
        "assessments": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"$ref": "#/$defs/ProcessBoundaryAssessment"}
        },
        "obligation_mapping": {
          "oneOf": [
            {"$ref": "#/$defs/ProcessBoundaryObligationMapping"},
            {"type": "null"}
          ]
        },
        "evidence_artifact_ids": {"$ref": "#/$defs/IdList"}
      }
    },
    "ProcessReviewStatus": {
      "type": "string",
      "enum": ["reviewing", "completed", "failed"]
    },
    "ProcessReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "draft_id",
        "run_id",
        "reviewer_session_ref_id",
        "status",
        "created_at",
        "completed_at",
        "preserves_boundary",
        "report",
        "error"
      ],
      "properties": {
        "review_id": {"$ref": "common.schema.json#/$defs/Id"},
        "draft_id": {"$ref": "common.schema.json#/$defs/Id"},
        "run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "reviewer_session_ref_id": {"$ref": "common.schema.json#/$defs/Id"},
        "status": {"$ref": "#/$defs/ProcessReviewStatus"},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "completed_at": {"$ref": "#/$defs/NullableUtcDateTime"},
        "preserves_boundary": {"type": ["boolean", "null"]},
        "report": {
          "oneOf": [
            {"$ref": "#/$defs/ProcessBoundaryReport"},
            {"type": "null"}
          ]
        },
        "error": {"$ref": "#/$defs/NullableString"}
      }
    },
    "ProcessDraftReviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft_id", "reviews"],
      "properties": {
        "draft_id": {"$ref": "common.schema.json#/$defs/Id"},
        "reviews": {
          "type": "array",
          "items": {"$ref": "#/$defs/ProcessReview"}
        }
      }
    },
    "PlanningTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id", "message", "status", "reply", "plan_revision_id", "agent_session_ref_id", "error"
      ],
      "properties": {
        "turn_id": {"$ref": "common.schema.json#/$defs/Id"},
        "message": {"type": "string"},
        "status": {"enum": ["running", "completed", "failed"]},
        "reply": {"type": ["string", "null"]},
        "plan_revision_id": {"$ref": "#/$defs/NullableId"},
        "agent_session_ref_id": {"$ref": "#/$defs/NullableId"},
        "error": {"type": ["string", "null"]}
      }
    },
    "PlanningConversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "goal_id", "workspace", "turns"],
      "properties": {
        "conversation_id": {"$ref": "common.schema.json#/$defs/Id"},
        "goal_id": {"$ref": "common.schema.json#/$defs/Id"},
        "workspace": {"type": ["string", "null"]},
        "source_run_id": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/Id"}, {"type": "null"}]
        },
        "turns": {"type": "array", "items": {"$ref": "#/$defs/PlanningTurn"}}
      }
    },
    "PlanningConversationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {"data": {"$ref": "#/$defs/PlanningConversation"}}
    },
    "Attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "run_id",
        "process_revision_id",
        "plan_node_id",
        "sequence",
        "status",
        "artifact_ids",
        "created_at",
        "started_at",
        "ended_at",
        "outcome_reason"
      ],
      "properties": {
        "attempt_id": {"$ref": "common.schema.json#/$defs/Id"},
        "run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "process_revision_id": {"$ref": "#/$defs/NullableId"},
        "plan_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "sequence": {"type": "integer", "minimum": 1},
        "status": {"$ref": "#/$defs/AttemptStatus"},
        "artifact_ids": {"$ref": "#/$defs/IdList"},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "started_at": {"$ref": "#/$defs/NullableUtcDateTime"},
        "ended_at": {"$ref": "#/$defs/NullableUtcDateTime"},
        "outcome_reason": {"$ref": "#/$defs/NullableString"}
      }
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "name",
        "media_type",
        "size_bytes",
        "sha256",
        "created_at",
        "run_id",
        "plan_node_id",
        "attempt_id"
      ],
      "properties": {
        "artifact_id": {"$ref": "common.schema.json#/$defs/Id"},
        "kind": {"$ref": "#/$defs/ArtifactKind"},
        "name": {"type": "string"},
        "media_type": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "run_id": {"$ref": "#/$defs/NullableId"},
        "plan_node_id": {"$ref": "#/$defs/NullableId"},
        "attempt_id": {"$ref": "#/$defs/NullableId"}
      }
    },
    "CheckSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "kind",
        "description",
        "required",
        "command_argv",
        "semantic_required_terms"
      ],
      "properties": {
        "check_id": {"$ref": "common.schema.json#/$defs/Id"},
        "name": {"type": "string"},
        "kind": {"$ref": "#/$defs/CheckKind"},
        "description": {"type": "string"},
        "required": {"type": "boolean"},
        "command_argv": {
          "type": "array",
          "items": {"type": "string"}
        },
        "semantic_required_terms": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "CheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "check_run_id",
        "run_id",
        "plan_node_id",
        "attempt_id",
        "passed",
        "evaluated_at",
        "evidence_artifact_ids",
        "output",
        "failure_reason"
      ],
      "properties": {
        "check_id": {"$ref": "common.schema.json#/$defs/Id"},
        "check_run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "adoption_id": {"$ref": "#/$defs/NullableId"},
        "run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "plan_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "attempt_id": {"$ref": "common.schema.json#/$defs/Id"},
        "passed": {"type": "boolean"},
        "evaluated_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "evidence_artifact_ids": {"$ref": "#/$defs/IdList"},
        "output": {"$ref": "#/$defs/NullableString"},
        "failure_reason": {"$ref": "#/$defs/NullableString"}
      }
    },
    "HumanCheckEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"$ref": "common.schema.json#/$defs/Id"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ResultAdoption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_id",
        "target_run_id",
        "target_plan_revision_id",
        "target_plan_node_id",
        "source_run_id",
        "source_plan_revision_id",
        "source_process_revision_id",
        "source_plan_node_id",
        "source_attempt_id",
        "evidence",
        "reason",
        "created_at"
      ],
      "properties": {
        "adoption_id": {"$ref": "common.schema.json#/$defs/Id"},
        "target_run_id": {"$ref": "common.schema.json#/$defs/Id"},
        "target_plan_revision_id": {"$ref": "common.schema.json#/$defs/Id"},
        "target_plan_node_id": {"$ref": "common.schema.json#/$defs/Id"},
        "source_run_id": {"$ref": "common.schema.json#/$defs/Id"},
