{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ehai.local/v1/commands.schema.json",
  "title": "EHAI P1 command contracts",
  "$defs": {
    "JsonScalar": {
      "anyOf": [
        {"type": "boolean"},
        {"type": "integer"},
        {"type": "number"},
        {"type": "string"},
        {"type": "null"}
      ]
    },
    "JsonValue": {
      "anyOf": [
        {"$ref": "#/$defs/JsonScalar"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/JsonValue"}
        },
        {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/JsonValue"}
        }
      ]
    },
    "P1CompletionCriterion": {
      "type": "string",
      "enum": [
        "artifact:non-empty",
        "command:exit-zero",
        "semantic:required-terms"
      ]
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name", "created_at"],
      "properties": {
        "project_id": {"$ref": "common.schema.json#/$defs/Id"},
        "name": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"}
      }
    },
    "CompletionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_contract_id",
        "goal_id",
        "version",
        "criteria",
        "required_check_ids",
        "created_at",
        "confirmed_at",
        "supersedes_completion_contract_id"
      ],
      "properties": {
        "completion_contract_id": {"$ref": "common.schema.json#/$defs/Id"},
        "goal_id": {"$ref": "common.schema.json#/$defs/Id"},
        "version": {"type": "integer", "minimum": 1},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/P1CompletionCriterion"}
        },
        "required_check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/Id"}
        },
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "confirmed_at": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/UtcDateTime"},
            {"type": "null"}
          ]
        },
        "supersedes_completion_contract_id": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/Id"},
            {"type": "null"}
          ]
        }
      }
    },
    "Goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "project_id",
        "objective",
        "created_at",
        "completion_contract",
        "status",
        "final_gate_id",
        "satisfied_at"
      ],
      "properties": {
        "goal_id": {"$ref": "common.schema.json#/$defs/Id"},
        "project_id": {"$ref": "common.schema.json#/$defs/Id"},
        "objective": {"type": "string", "minLength": 1},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcDateTime"},
        "completion_contract": {
          "oneOf": [
            {"$ref": "#/$defs/CompletionContract"},
            {"type": "null"}
          ]
        },
        "status": {"type": "string", "enum": ["open", "satisfied"]},
        "final_gate_id": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/Id"},
            {"type": "null"}
          ]
        },
        "satisfied_at": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/UtcDateTime"},
            {"type": "null"}
          ]
        }
      }
    },
    "CreateProjectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "name"],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"},
        "name": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "CreateGoalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "project_id", "objective"],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"},
        "project_id": {"$ref": "common.schema.json#/$defs/IdInput"},
        "objective": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "ProposePlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "goal_id", "criteria"],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"},
        "goal_id": {"$ref": "common.schema.json#/$defs/IdInput"},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/P1CompletionCriterion"}
        }
      }
    },
    "ReplanPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "base_plan_revision_id", "criteria"],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"},
        "base_plan_revision_id": {"$ref": "common.schema.json#/$defs/IdInput"},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/P1CompletionCriterion"}
        }
      }
    },
    "ApprovePlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "plan_revision_id",
        "completion_contract_id"
      ],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"},
        "plan_revision_id": {"$ref": "common.schema.json#/$defs/IdInput"},
        "completion_contract_id": {"$ref": "common.schema.json#/$defs/IdInput"}
      }
    },
    "StartRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key", "plan_revision_id"],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"},
        "plan_revision_id": {"$ref": "common.schema.json#/$defs/IdInput"}
      }
    },
    "RunActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key"],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"}
      }
    },
    "PauseRunRequest": {"$ref": "#/$defs/RunActionRequest"},
    "ResumeRunRequest": {"$ref": "#/$defs/RunActionRequest"},
    "CancelRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotency_key"],
      "properties": {
        "idempotency_key": {"$ref": "common.schema.json#/$defs/IdempotencyKey"},
        "reason": {
          "default": null,
          "anyOf": [
            {"type": "string", "minLength": 1, "pattern": "\\S"},
            {"type": "null"}
          ]
        }
      }
    },
    "DataResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {"$ref": "#/$defs/JsonValue"}
      }
    },
    "ProjectResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {"data": {"$ref": "#/$defs/Project"}}
    },
    "GoalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {"data": {"$ref": "#/$defs/Goal"}}
    },
    "PlanGraphResponse": {
      "$ref": "queries.schema.json#/$defs/PlanGraphResponse"
    },
    "RunResponse": {
      "$ref": "queries.schema.json#/$defs/RunResponse"
    }
  }
}
