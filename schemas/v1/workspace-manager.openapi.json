{
  "openapi": "3.1.0",
  "info": {
    "title": "EHAI Workspace Manager",
    "version": "1"
  },
  "paths": {
    "/api/v1/workspaces": {
      "get": {
        "summary": "List Workspaces",
        "operationId": "listWorkspaces",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register Workspace",
        "operationId": "registerWorkspace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceRegistration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}": {
      "get": {
        "summary": "Get Workspace",
        "operationId": "getWorkspace",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/start": {
      "post": {
        "summary": "Start Workspace",
        "operationId": "startWorkspace",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/stop": {
      "post": {
        "summary": "Stop Workspace",
        "operationId": "stopWorkspace",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/execution-config": {
      "get": {
        "summary": "Get Execution Config",
        "operationId": "getWorkspaceExecutionConfig",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Workspace Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceExecutionConfigResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspace-overview": {
      "get": {
        "summary": "Overview",
        "operationId": "getWorkspaceOverview",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceOverviewResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonScalar": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "JsonValue": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/JsonScalar"
          },
          {
            "items": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "array"
          },
          {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object"
          }
        ]
      },
      "PublicRuntimeSettings": {
        "properties": {
          "worker_kind": {
            "type": "string",
            "enum": [
              "pi",
              "fake"
            ],
            "title": "Worker Kind"
          },
          "planner_kind": {
            "type": "string",
            "enum": [
              "pi",
              "single"
            ],
            "title": "Planner Kind"
          },
          "worker_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Model"
          },
          "planner_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planner Model"
          },
          "worker_reasoning_effort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Reasoning Effort"
          },
          "planner_reasoning_effort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Planner Reasoning Effort"
          },
          "worker_capacity": {
            "type": "integer",
            "title": "Worker Capacity"
          },
          "planner_capacity": {
            "type": "integer",
            "title": "Planner Capacity"
          },
          "worker_timeout_seconds": {
            "type": "number",
            "title": "Worker Timeout Seconds"
          },
          "planner_timeout_seconds": {
            "type": "number",
            "title": "Planner Timeout Seconds"
          },
          "command_timeout_seconds": {
            "type": "number",
            "title": "Command Timeout Seconds"
          },
          "allowed_commands": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Allowed Commands"
          },
          "available_shells": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available Shells"
          },
          "git_permissions": {
            "items": {
              "type": "string",
              "enum": [
                "git.read",
                "git.local_write",
                "git.remote_write",
                "git.dangerous"
              ]
            },
            "type": "array",
            "title": "Git Permissions"
          },
          "command_check_argv": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Command Check Argv"
          },
          "semantic_required_terms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Semantic Required Terms"
          },
          "attempt_deadline_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Deadline Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "worker_kind",
          "planner_kind",
          "worker_model",
          "planner_model",
          "worker_reasoning_effort",
          "planner_reasoning_effort",
          "worker_capacity",
          "planner_capacity",
          "worker_timeout_seconds",
          "planner_timeout_seconds",
          "command_timeout_seconds",
          "allowed_commands",
          "available_shells",
          "git_permissions",
          "command_check_argv",
          "semantic_required_terms",
          "attempt_deadline_seconds"
        ],
        "title": "PublicRuntimeSettings"
      },
      "RuntimeSettings": {
        "properties": {
          "worker_kind": {
            "type": "string",
            "enum": [
              "pi",
              "fake"
            ],
            "title": "Worker Kind",
            "default": "fake"
          },
          "planner_kind": {
            "type": "string",
            "enum": [
              "pi",
              "single"
            ],
            "title": "Planner Kind",
            "default": "single"
          },
          "worker_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Model"
          },
          "planner_model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Planner Model"
          },
          "worker_reasoning_effort": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Reasoning Effort"
          },
          "planner_reasoning_effort": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Planner Reasoning Effort"
          },
          "worker_capacity": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Worker Capacity",
            "default": 1
          },
          "planner_capacity": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Planner Capacity",
            "default": 1
          },
          "worker_timeout_seconds": {
            "type": "number",
            "maximum": 86400.0,
            "exclusiveMinimum": 0.0,
            "title": "Worker Timeout Seconds",
            "default": 300
          },
          "planner_timeout_seconds": {
            "type": "number",
            "maximum": 86400.0,
            "exclusiveMinimum": 0.0,
            "title": "Planner Timeout Seconds",
            "default": 120
          },
          "command_timeout_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Command Timeout Seconds",
            "default": 30
          },
          "pi_config_path": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Pi Config Path"
          },
          "allowed_commands": {
            "items": {
              "items": {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              },
              "type": "array"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Allowed Commands"
          },
          "available_shells": {
            "items": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 32,
            "title": "Available Shells"
          },
          "git_permissions": {
            "items": {
              "type": "string",
              "enum": [
                "git.read",
                "git.local_write",
                "git.remote_write",
                "git.dangerous"
              ]
            },
            "type": "array",
            "maxItems": 4,
            "title": "Git Permissions"
          },
          "command_check_argv": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "maxLength": 4096,
                  "minLength": 1
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Command Check Argv"
          },
          "semantic_required_terms": {
            "items": {
              "type": "string",
              "maxLength": 4096,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "title": "Semantic Required Terms"
          },
          "attempt_deadline_seconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 86400.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Deadline Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RuntimeSettings",
        "description": "Fixed executable assembly; this profile never grants a Run execution authorization."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WorkspaceActionRequest": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "WorkspaceActionRequest"
      },
      "WorkspaceDescriptor": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Workspace Id"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "runtime": {
            "$ref": "#/components/schemas/PublicRuntimeSettings"
          },
          "status": {
            "type": "string",
            "enum": [
              "registered",
              "starting",
              "ready",
              "stopping",
              "stopped",
              "failed"
            ],
            "title": "Status"
          },
          "failure_category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "startup_timeout",
                  "child_exited",
                  "identity_mismatch",
                  "shutdown_timeout",
                  "launch_failed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Category"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workspace_id",
          "path",
          "runtime",
          "status",
          "failure_category"
        ],
        "title": "WorkspaceDescriptor"
      },
      "WorkspaceExecutionConfigData": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Workspace Id"
          },
          "execution_config": {
            "anyOf": [
              {
                "$ref": "commands.schema.json#/$defs/ExecutionConfigRequest"
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Config"
          }
        },
        "type": "object",
        "required": [
          "workspace_id",
          "execution_config"
        ],
        "title": "WorkspaceExecutionConfigData"
      },
      "WorkspaceExecutionConfigResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkspaceExecutionConfigData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "WorkspaceExecutionConfigResponse"
      },
      "WorkspaceListData": {
        "properties": {
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceDescriptor"
            },
            "type": "array",
            "title": "Workspaces"
          }
        },
        "type": "object",
        "required": [
          "workspaces"
        ],
        "title": "WorkspaceListData"
      },
      "WorkspaceListResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkspaceListData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "WorkspaceListResponse"
      },
      "WorkspaceOverviewData": {
        "properties": {
          "observed_at": {
            "type": "string",
            "title": "Observed At"
          },
          "workspaces": {
            "items": {
              "$ref": "#/components/schemas/WorkspaceOverviewEntry"
            },
            "type": "array",
            "title": "Workspaces"
          },
          "consistent_across_workspaces": {
            "type": "boolean",
            "const": false,
            "title": "Consistent Across Workspaces",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "observed_at",
          "workspaces"
        ],
        "title": "WorkspaceOverviewData"
      },
      "WorkspaceOverviewEntry": {
        "properties": {
          "workspace": {
            "$ref": "#/components/schemas/WorkspaceDescriptor"
          },
          "api_path": {
            "type": "string",
            "title": "Api Path"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "projects": {
            "anyOf": [
              {
                "items": {
                  "$ref": "queries.schema.json#/$defs/ProjectDetailView"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Projects"
          },
          "inbox": {
            "anyOf": [
              {
                "$ref": "queries.schema.json#/$defs/InboxListView"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inbox"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WorkspaceQueryError"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "workspace",
          "api_path",
          "available",
          "projects",
          "inbox",
          "error"
        ],
        "title": "WorkspaceOverviewEntry"
      },
      "WorkspaceOverviewResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkspaceOverviewData"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "WorkspaceOverviewResponse"
      },
      "WorkspaceQueryError": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "WorkspaceQueryError"
      },
      "WorkspaceRegistration": {
        "properties": {
          "workspace_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Workspace Id"
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Path"
          },
          "runtime": {
            "$ref": "#/components/schemas/RuntimeSettings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "workspace_id",
          "path"
        ],
        "title": "WorkspaceRegistration"
      },
      "WorkspaceResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WorkspaceDescriptor"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "WorkspaceResponse"
      }
    }
  },
  "x-ehai-workspace-manager": true
}
